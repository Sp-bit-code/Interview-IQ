<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <!-- ===============================
         SPRING BOOT PARENT
         =============================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>


    <!-- ===============================
         PROJECT INFORMATION
         =============================== -->

    <groupId>com.interviewiq</groupId>

    <artifactId>progress-service</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>Interview IQ Progress Service</name>

    <description>
        Spring Boot study progress service for Interview-IQ
    </description>


    <!-- ===============================
         JAVA VERSION
         =============================== -->

    <properties>

        <java.version>17</java.version>

    </properties>


    <!-- ===============================
         DEPENDENCIES
         =============================== -->

    <dependencies>


        <!--
            Spring Web

            Used for:

            @RestController
            @RequestMapping
            @GetMapping
            @PostMapping
            @DeleteMapping
            REST APIs

            It also allows React frontend
            to communicate with Spring Boot.
        -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-web</artifactId>

        </dependency>


        <!--
            Validation

            Used with:

            @Valid
            @NotBlank
            @NotNull

            This validates incoming API data.
        -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-validation</artifactId>

        </dependency>


        <!--
            Jakarta Annotation API

            Used for Bean Life Cycle:

            @PostConstruct
            @PreDestroy
        -->

        <dependency>

            <groupId>jakarta.annotation</groupId>

            <artifactId>jakarta.annotation-api</artifactId>

        </dependency>


        <!--
            Spring Boot Testing
        -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-test</artifactId>

            <scope>test</scope>

        </dependency>


    </dependencies>


    <!-- ===============================
         BUILD CONFIGURATION
         =============================== -->

    <build>

        <plugins>


            <!--
                Creates executable Spring Boot JAR
                used by Docker / Render
            -->

            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>


        </plugins>

    </build>


</project>
