from pathlib import Path

PROJECT_ROOT = Path(r"C:\Users\LENOVO\Desktop\Final Placement\interviewiq-main")

folders = [
    # FastAPI backend
    "rag-backend",
    "rag-backend/app",
    "rag-backend/app/routes",
    "rag-backend/app/schemas",
    "rag-backend/src",
    "rag-backend/storage",
    "rag-backend/storage/uploads",
    "rag-backend/storage/vectorstores",
    "rag-backend/storage/sessions",
    "rag-backend/scripts",

    # React frontend new pages
    "src/pages",
    "src/lib",
    "src/store",
]

files = [
    # Backend root files
    "rag-backend/main.py",
    "rag-backend/requirements.txt",
    "rag-backend/Dockerfile",
    "rag-backend/render.yaml",

    # Backend app files
    "rag-backend/app/__init__.py",
    "rag-backend/app/routes/__init__.py",
    "rag-backend/app/routes/health_routes.py",
    "rag-backend/app/routes/notes_routes.py",
    "rag-backend/app/routes/flashcard_routes.py",
    "rag-backend/app/routes/resume_routes.py",

    "rag-backend/app/schemas/__init__.py",
    "rag-backend/app/schemas/notes_schema.py",
    "rag-backend/app/schemas/flashcard_schema.py",
    "rag-backend/app/schemas/resume_schema.py",

    # Backend RAG source files
    "rag-backend/src/__init__.py",
    "rag-backend/src/chunker.py",
    "rag-backend/src/config.py",
    "rag-backend/src/embeddings.py",
    "rag-backend/src/ocr_processor.py",
    "rag-backend/src/pdf_processor.py",
    "rag-backend/src/prompts.py",
    "rag-backend/src/rag_chain.py",
    "rag-backend/src/resume.py",
    "rag-backend/src/session_manager.py",
    "rag-backend/src/vector_store.py",

    # Backend scripts
    "rag-backend/scripts/clear_data.py",

    # Frontend new helper
    "src/lib/ragApi.js",

    # Frontend new pages
    "src/pages/StudyNotes.jsx",
    "src/pages/StudyNotes.css",
    "src/pages/Flashcards.jsx",
    "src/pages/Flashcards.css",
    "src/pages/ResumeGapFinder.jsx",
    "src/pages/ResumeGapFinder.css",

    # Optional frontend store
    "src/store/useRagStore.js",
]

def create_structure():
    if not PROJECT_ROOT.exists():
        raise FileNotFoundError(f"Project root not found: {PROJECT_ROOT}")

    print(f"Creating structure inside:\n{PROJECT_ROOT}\n")

    for folder in folders:
        path = PROJECT_ROOT / folder
        path.mkdir(parents=True, exist_ok=True)
        print(f"Folder ready: {path}")

    print("\nCreating files...\n")

    for file in files:
        path = PROJECT_ROOT / file
        path.parent.mkdir(parents=True, exist_ok=True)

        if path.exists():
            print(f"Skipped existing file: {path}")
        else:
            path.touch()
            print(f"Created file: {path}")

    print("\nDone. Structure created successfully.")

if __name__ == "__main__":
    create_structure()